{
  "name": "patchpilot",
  "version": "0.4.0",
  "private": true,
  "description": "Android app that finds and verifies the exact APK a Morphe patch bundle needs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "fixtures": "tsx src/core/apk/fixture.ts",
    "version:next": "tsx scripts/next-version.ts",
    "release:notes": "tsx scripts/next-version.ts --notes-out release-notes.md",
    "android": "npm run build && cd android && gradle assembleDebug",
    "android:release": "npm run build && cd android && gradle assembleRelease",
    "check:java": "node scripts/check-java.mjs",
    "changelog": "tsx scripts/changelog.ts",
    "changelog:check": "tsx scripts/changelog.ts --check"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "java-parser": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
